NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: https://www.mylivingpage.com

# Server-only administrator allowlist. Required in Vercel Production and Preview
# for /admin access; use the verified email of the owner account.
ADMIN_EMAIL=

# Signup CAPTCHA
# Production also needs Cloudflare Turnstile enabled in Supabase Auth > CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=

# Legal / public policy pages
# These are launch-blocking. Leaving them blank keeps placeholder fallback copy on the public legal pages.
# Set per deployment so marketing and legal routes can be statically generated.
NEXT_PUBLIC_LEGAL_SITE=mylivingpage
NEXT_PUBLIC_LEGAL_COMPANY_NAME=
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_MAILING_ADDRESS=
NEXT_PUBLIC_DMCA_AGENT_NAME=
NEXT_PUBLIC_DMCA_AGENT_EMAIL=
NEXT_PUBLIC_DMCA_AGENT_ADDRESS=
NEXT_PUBLIC_DMCA_AGENT_PHONE=
NEXT_PUBLIC_SECURITY_EMAIL=

# E2E / CI (staging-only credentials)
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
PLAYWRIGHT_SIGNUP_EMAIL_DOMAIN=
PLAYWRIGHT_EXPECT_SIGNUP_CONFIRMATION=
PLAYWRIGHT_SUPABASE_URL=
PLAYWRIGHT_SUPABASE_PUBLISHABLE_KEY=
PLAYWRIGHT_SUPABASE_SERVICE_ROLE_KEY=
PLAYWRIGHT_STRIPE_SECRET_KEY=
PLAYWRIGHT_STRIPE_WEBHOOK_SECRET=
PLAYWRIGHT_GOOGLE_EMAIL=
PLAYWRIGHT_GOOGLE_PASSWORD=
ENABLE_E2E_FAILURE_INJECTION=0
RUN_LIVE_STRIPE_CONFIG_TESTS=0
